# 跨平台行尾规范化：所有设备 checkout 统一 LF，防 Windows CRLF 破坏脚本
* text=auto

# 文本文件强制 LF（Python/Shell/文档/数据）
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.d2 text eol=lf
*.ps1 text eol=lf

# 二进制文件（不转换）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.ttf binary
*.woff binary
*.woff2 binary
*.zip binary
*.gz binary

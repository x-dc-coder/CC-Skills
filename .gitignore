# uv 虚拟环境（由 uv.lock + pyproject.toml 重建）
.venv/

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 生成物（ER 图、流程图 PNG 等）
*.png
*.jpg
*.jpeg
*.pdf
*.svg

# 本地导出文件
*.docx
*.md.docx
*.zip
*.tar.gz

# 系统文件
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# 日志
*.log

# Windows Alternate Data Streams (WSL 与 Windows 交互产生的元数据)
*:*
*Zone.Identifier

# gitcode-workflow shared ignore rules
logs/
*.py[cod]
venv/
.coverage
dist/

# md-to-thesis-latex 输出产物（避免仓库污染）
thesis/

# LaTeX 编译中间文件
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.xdv

# skills 临时目录
tmp/

# 论文提取输出产物（个人文件，不提交）
output/

# skill 评估工作区（临时评估数据）
kimi-web-search-workspace/

# Claude Code 本地设置（机器相关，不纳入版本控制）
.claude/settings.local.json
